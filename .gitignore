# build / verify leftovers
__pycache__/
*.pyc
*.log

# test artefacts that must never end up in a release
_fakewim_test.*
_realwim_test.*
_xmlbug_test.*

# generated by make_gui_preview.py (throw-away copies used for screenshots)
src/build/gui_preview_*.ps1

# release artifacts (zips + checksums go to the GitHub Release page, not the repo)
_release/

# OS noise
Thumbs.db
desktop.ini
.DS_Store

# local user images (never commit multi-GB Windows images)
*.wim
*.esd
*.iso
*.vhdx
